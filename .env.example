# DB_NAME=elhacedor
# DB_USER=elhacedor
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
